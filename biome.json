{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "public/js/**/*.js",
      "server.ts",
      "server/**/*.ts",
      "scripts/**/*.ts",
      "tests/**/*.ts",
      "tests/**/*.js"
    ]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "assist": { "enabled": false }
}
