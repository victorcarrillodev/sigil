{
  "name": "sigil",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "check": "biome lint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "bun test",
    "validate": "bun run check && bun test",
    "vendor": "bun run scripts/vendor-three.ts",
    "postinstall": "bun run scripts/vendor-three.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
