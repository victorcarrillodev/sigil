{
  "name": "sigil",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build && bun scripts/prerender.ts",
    "start": "NODE_ENV=production bun server.ts",
    "preview": "NODE_ENV=production bun server.ts",
    "check": "biome lint . && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "bun test ./tests",
    "validate": "bun run check && bun run test && bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  }
}
